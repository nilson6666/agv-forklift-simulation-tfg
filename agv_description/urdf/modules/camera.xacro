<?xml version="1.0" ?>
<!-- Adapted from onshape-to-robot output for the new AGV model -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- MAST CAMERA (on camera_suport_link, tilted downwards)               -->
  <!-- ================================================================== -->
  <link name="mast_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-09"/>
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0.02 0" rpy="${-pi} 0 0"/>
      <geometry>
        <mesh filename="package://agv_description/assets/camera.stl"/>
      </geometry>
      <material name="camera_material">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.03 0.02 0" rpy="${-pi} 0 0"/>
      <geometry>
        <mesh filename="package://agv_description/assets/camera.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="mast_camera_joint" type="fixed">
    <origin xyz="0.325 0.035 -0.0290993" rpy="0 ${pi/2 + 0.349066} ${-pi/2}"/>
    <parent link="camera_suport_link"/>
    <child link="mast_camera_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
  </joint>

  <!-- Optical frame for the mast camera (ROS Z-forward convention)  -->
  <link name="mast_camera_optical_link"/>

  <joint name="mast_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="mast_camera_link"/>
    <child link="mast_camera_optical_link"/>
  </joint>

  <!-- ================================================================== -->
  <!-- FORK CAMERA (between the fork tines)                                -->
  <!-- ================================================================== -->
  <link name="fork_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-09"/>
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09"/>
    </inertial>
    <visual>
      <origin xyz="-0.02 0.03 0" rpy="${pi} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://agv_description/assets/camera.stl"/>
      </geometry>
      <material name="camera_material"/>
    </visual>
    <collision>
      <origin xyz="-0.02 0.03 0" rpy="${pi} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://agv_description/assets/camera.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Docking camera: first lowered 0.247 m from the Onshape export
       (z -0.0101 -> -0.257) to sit at the height of the pallet tag
       (0.30 m with joints at zero, 0.15 m with the tines down). At the
       original height (0.547 m) the tag (centre at 0.072 m) was either
       unreadable from afar or fell outside the vfov (+-24 degrees) up
       close. Like the tines: if re-exported from CAD, re-apply this.

       Final position (in the joint below): raised 0.40 m above that
       height (z -0.257 -> +0.143) and tilted 30 degrees downwards.
       Reason: to stack, the camera must see the tag of the pallet BELOW
       while carrying another one, and when mounted low the carried
       pallet blocks the view. In this position it detects well at the
       real AlinearAmbPila distance (~3.9 m base-tag).
       Known trade-off: the angle needed to see the tag is
       atan(relative height / distance), very sensitive up close, and
       with the camera this high close-range detection (0.30-1.25 m
       camera-tag) is worse than in the low position. The mission does
       not depend on it: the visual servo stops at the standoff
       (camera-tag ~1.35 m) and tine insertion is blind, by odometry. -->
  <joint name="fork_camera_joint" type="fixed">
    <origin xyz="-0.275814 0.232627 0.143" rpy="0 ${30*pi/180} ${pi/2}"/>
    <parent link="fork_link"/>
    <child link="fork_camera_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
  </joint>

  <!-- Optical frame for the fork camera (ROS Z-forward convention)       -->
  <link name="fork_camera_optical_link"/>

  <joint name="fork_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="fork_camera_link"/>
    <child link="fork_camera_optical_link"/>
  </joint>

</robot>