<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- ================================================================== -->
  <!-- MECANUM WHEELS — anisotropic friction to simulate 45° rollers       -->
  <!-- ================================================================== -->

  <!-- FRONT LEFT (wheel_right mesh, rollers /)  -->
  <gazebo reference="front_left_wheel_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.5</mu>
                        <mu2>0.2</mu2>
                        <fdir1 gz:expressed_in="base_footprint_link">1 -1 0</fdir1>
                    </ode>
                </friction>
            </surface>
        </collision>
  </gazebo>

  <!-- REAR LEFT (wheel_left mesh, rollers \)  -->
  <gazebo reference="rear_left_wheel_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.5</mu>
                        <mu2>0.2</mu2>
                        <fdir1 gz:expressed_in="base_footprint_link">-1 -1 0</fdir1>
                    </ode>
                </friction>
            </surface>
        </collision>
  </gazebo>

  <!-- FRONT RIGHT (wheel_left mesh, rollers \)  -->
  <gazebo reference="front_right_wheel_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.5</mu>
                        <mu2>0.2</mu2>
                        <fdir1 gz:expressed_in="base_footprint_link">-1 -1 0</fdir1>
                    </ode>
                </friction>
            </surface>
        </collision>
  </gazebo>

  <!-- REAR RIGHT (wheel_right mesh, rollers /)  -->
  <gazebo reference="rear_right_wheel_link">
       <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.5</mu>
                        <mu2>0.2</mu2>
                        <fdir1 gz:expressed_in="base_footprint_link">1 -1 0</fdir1>
                    </ode>
                </friction>
            </surface>
        </collision>
  </gazebo>

  <!-- ================================================================== -->
  <!-- SELF-INVISIBILITY TO THE LIDARS — the whole robot body outside bit 0 -->
  <!-- The gpu_lidars (visibility_mask=1) raycast against VISUALS;         -->
  <!-- the chassis crosses the scan plane (verified hit at 0.17 m that     -->
  <!-- left marks on the SLAM map), and the tines (z 0.03-0.24) and wheels -->
  <!-- (top 0.356) also cross it depending on the joint positions. The     -->
  <!-- cameras are NOT affected (default all-ones mask).                   -->
  <!-- Same trick as the lidar housings in gazebo_plugins.xacro.           -->
  <!-- ================================================================== -->

  <gazebo reference="chassis_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="fixed_mast_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="moving_mast_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="fork_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="camera_suport_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="front_left_wheel_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <visual><visibility_flags>4294967294</visibility_flags></visual>
  </gazebo>

  <!-- ================================================================== -->
  <!-- GAZEBO MATERIALS (basic display if the meshes do not load)          -->
  <!-- ================================================================== -->

  <gazebo reference="chassis_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="fixed_mast_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="moving_mast_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="fork_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="camera_suport_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="mast_camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="fork_camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_right_laser_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="rear_left_laser_link">
    <material>Gazebo/Black</material>
  </gazebo>

</robot>